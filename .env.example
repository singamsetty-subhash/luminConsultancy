# ===================================================================
# Lumin Consultancy Environment Configuration Template (.env.example)
# ===================================================================

# Web Server Port
PORT=8080
APP_ENV=development

# Local MySQL Database Configuration (Default)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumindb
DB_USER=root
DB_PASS=root
DB_SSLMODE=prefer

# Local Database URL
DATABASE_URL=mysql://root:root@localhost:3306/lumindb

