# ===================================================================
# Lumin Consultancy Environment Configuration Template (.env.example)
# ===================================================================

# Web Server Port
PORT=8000
APP_ENV=development

# MySQL Database Configuration (Default)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumindb
DB_USER=root
DB_PASS=root
DB_SSLMODE=prefer

# Database URL
DATABASE_URL=mysql://root:root@localhost:3306/lumindb

# Consultation Enquiry Recipient Email
ENQUIRY_TO=ceo.lumin@gmail.com

# SMTP Outbound Email Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
