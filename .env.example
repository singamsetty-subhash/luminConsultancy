# ===================================================================
# Lumin Consultancy Environment Configuration (.env)
# ===================================================================

# Web Server Port
PORT=8080
APP_ENV=development

# MySQL Database Configuration
# Default matches previous Spring Boot configuration

# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=lumindb
# DB_USER=root
# DB_PASS=root

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumindb
DB_USER=root
DB_PASS=root

# Cloud / Railway deployment single URL (optional, overrides above if set)
# MYSQL_URL=mysql://root:password@localhost:3306/lumindb

# Consultation Enquiry Recipient Email
ENQUIRY_TO=ceo.lumin@gmail.com

# SMTP Outbound Email Notification Configuration
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
